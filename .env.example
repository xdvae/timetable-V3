# Copy this to .env for local testing, or set these as real environment
# variables in your hosting platform's dashboard for a production deploy.
# Every one of these is read once, on first startup, to set up a fresh
# deployment for ONE institution — see app.py's init_admin_from_env().

# A long random string used to sign login session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If you don't set this, a random one is generated every restart, which
# means everyone gets logged out every time the app restarts — fine for
# a quick local test, NOT fine for a real deploy.
SECRET_KEY=

# Shown as the session name on the dashboard until changed in Config.
INSTITUTION_NAME=Example College

# The login created the FIRST time the app starts. If ADMIN_PASSWORD is
# left blank, a random password is generated and printed to the server
# log once — set a real one here for a production deploy instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Defaults to a local SQLite file if unset. Only change this if you're
# moving to Postgres for a more durable production deployment.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
